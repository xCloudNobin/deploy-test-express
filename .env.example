# Server
HOST=0.0.0.0
PORT=3000

# Persistent SQLite database file. In production point this at a persistent
# volume or directory OUTSIDE the release checkout (ephemeral deployments would
# lose data). The parent directory is created automatically if needed.
DATABASE_PATH=/var/lib/deploy-test-express/data/taskboard.sqlite

# Optional non-sensitive release/build marker shown in the UI footer and /api/info.
# Defaults to a "local-<gitref>-<version>" value when unset.
BUILD_MARKER=

# Optional: set to 'production' for the production runtime.
NODE_ENV=production